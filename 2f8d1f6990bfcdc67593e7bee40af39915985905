        "patchSetId": 10
      },
      "lineNbr": 256,
      "author": {
        "id": 1006192
      },
      "writtenOn": "2026-10-24T20:14:14Z",
      "side": 1,
      "message": "The rendering is performed by the frontend; I wouldn\u0027t implement simulated rendering on the backend.\nI\u0027d rather align the license returned by the core plugins with the LICENSE file in the Apache 2.0 plugins repository.\n\nDone, PTAL 🙏",
      "parentUuid": "464bc260_9d9e113e",
      "revId": "2f8d1f6990bfcdc67593e7bee40af39915985905",
      "serverId": "173816e5-2b9a-37c3-8a2e-48639d4f1153"
